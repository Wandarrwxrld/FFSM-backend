# Copy this file to .env and fill in real values. .env is never committed.

# --- Database (matches ffms_schema.sql / MAMP defaults shown as example) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ffms_db
DB_USER=root
DB_PASS=root

# --- CORS: which front-end origins may call this API ---
# Local dev server + your live Netlify URL, comma-separated, no spaces.
ALLOWED_ORIGINS=http://localhost:5500,https://your-site.netlify.app
FRONTEND_URL=http://localhost:5500

# --- Token lifetimes ---
TOKEN_TTL_DAYS=30
VERIFICATION_TTL_HOURS=48
RESET_TTL_MINUTES=60

# --- SMTP (example values for Gmail; use an App Password, not your real
# password: https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM_EMAIL=you@gmail.com
MAIL_FROM_NAME=FFMS Farm Management
